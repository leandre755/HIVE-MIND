#!/bin/bash
# Git Hook: commit-msg
# Valide le format Conventional Commits
# Format: type(scope): description
# Types: feat, fix, chore, docs, refactor, test, ci, perf, build, style, revert

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

COMMIT_MSG_FILE=$1
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BLUE}📝 COMMIT MESSAGE VALIDATION${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

# Récupère seulement la première ligne (ignore les commentaires Git)
FIRST_LINE=$(echo "$COMMIT_MSG" | head -n1 | grep -v "^#")

# Si le message commence par Merge, Skip, ou Revert, l'accepte
if [[ $FIRST_LINE =~ ^(Merge|Skip|Revert) ]]; then
    echo -e "${GREEN}✅ Auto-merge/skip commit detected, validating skipped${NC}"
    exit 0
fi

# Pattern Conventional Commits: type(scope): description
# Type: required
# Scope: optional
# Description: required (at least 3 chars)
PATTERN='^(feat|fix|chore|docs|refactor|test|ci|perf|build|style|revert)(\(.+\))?: .{3,}'

if ! echo "$FIRST_LINE" | grep -E "$PATTERN" > /dev/null 2>&1; then
    echo -e "${RED}❌ Commit message does not follow Conventional Commits format${NC}"
    echo ""
    echo -e "${YELLOW}Your message:${NC}"
    echo "  $FIRST_LINE"
    echo ""
    echo -e "${YELLOW}Format required:${NC}"
    echo "  type(scope): description"
    echo ""
    echo -e "${YELLOW}Valid types:${NC}"
    echo "  feat      - A new feature"
    echo "  fix       - A bug fix"
    echo "  chore     - Maintenance tasks (deps, build, etc)"
    echo "  docs      - Documentation only changes"
    echo "  refactor  - Code refactoring without feature/fix"
    echo "  test      - Adding or updating tests"
    echo "  ci        - CI/CD pipeline changes"
    echo "  perf      - Performance improvements"
    echo "  build     - Build system changes"
    echo "  style     - Code style changes (formatting, semicolons, etc)"
    echo "  revert    - Reverts a previous commit"
    echo ""
    echo -e "${YELLOW}Examples:${NC}"
    echo "  feat(auth): add JWT token validation"
    echo "  fix(api): handle null pointer exception"
    echo "  chore: update dependencies"
    echo "  docs(readme): clarify installation steps"
    echo ""
    exit 1
fi

echo -e "${GREEN}✅ Commit message format is valid${NC}"
echo -e "${GREEN}   Message: $FIRST_LINE${NC}"
echo ""
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

exit 0
