{
  "name": "hive-mind",
  "version": "1.0.0",
  "description": "Bot WhatsApp modulaire avec architecture Brick-Like et multi-modèles IA",
  "type": "module",
  "main": "src/bin/hive-mind.ts",
  "bin": {
    "hive-mind": "./src/bin/hive-mind.ts"
  },
  "scripts": {
    "start": "NODE_NO_WARNINGS=1 tsx --env-file=.env src/bin/hive-mind.ts start",
    "dev": "NODE_NO_WARNINGS=1 tsx --env-file=.env --watch src/bin/hive-mind.ts start",
    "build": "tsc --noEmit",
    "lint": "eslint . --ext .js,.ts",
    "lint:fix": "eslint . --ext .js,.ts --fix",
    "lint:fast": "oxlint --deny-warnings src/",
    "lint:knip": "knip",
    "lint:arch": "depcruise --validate .dependency-cruiser.cjs src",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,md}\"",
    "audit:deps": "npm audit --audit-level=high",
    "repair": "tsx src/scripts/repair-session.ts",
    "audit:group": "tsx src/scripts/audit-group.ts",
    "fix:usernames": "tsx src/scripts/fix-missing-usernames.ts",
    "test": "NODE_ENV=test SUPABASE_URL=http://localhost:54321 SUPABASE_KEY=dummy REDIS_URL=redis://localhost:6379 NODE_OPTIONS='--experimental-vm-modules --no-warnings' jest --forceExit",
    "test:unit": "NODE_ENV=test SUPABASE_URL=http://localhost:54321 SUPABASE_KEY=dummy REDIS_URL=redis://localhost:6379 NODE_OPTIONS='--experimental-vm-modules --no-warnings' jest src/tests/unit",
    "test:integration": "NODE_ENV=test SUPABASE_URL=http://localhost:54321 SUPABASE_KEY=dummy REDIS_URL=redis://localhost:6379 NODE_OPTIONS='--experimental-vm-modules --no-warnings' jest src/tests/integration",
    "test:e2e": "NODE_ENV=test SUPABASE_URL=http://localhost:54321 SUPABASE_KEY=dummy REDIS_URL=redis://localhost:6379 NODE_OPTIONS='--experimental-vm-modules --no-warnings' jest src/tests/e2e",
    "postinstall": "npx playwright install chromium"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "ai",
    "baileys",
    "supabase"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "author": "leandre755",
  "license": "Apache-2.0",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.101.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@google/genai": "^2.0.0",
    "@google/generative-ai": "^0.24.1",
    "@iarna/toml": "^2.2.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@supabase/supabase-js": "^2.110.0",
    "@types/diff": "^7.0.2",
    "@vitalets/google-translate-api": "^9.2.0",
    "@whiskeysockets/baileys": "^6.7.0",
    "acorn": "^8.17.0",
    "acorn-walk": "^8.3.5",
    "agent-browser": "^0.31.1",
    "ajv": "^8.17.1",
    "audio-decode": "^2.2.3",
    "cheerio": "^1.1.2",
    "cli-progress": "^3.12.0",
    "command-exists": "^1.2.9",
    "commander": "^14.0.3",
    "comment-json": "^5.0.0",
    "cron-parser": "^5.6.1",
    "diff": "^9.0.0",
    "discord.js-selfbot-v13": "^3.7.1",
    "dotenv": "^17.2.3",
    "fluent-ffmpeg": "^2.1.3",
    "google-tts-api": "^2.0.2",
    "groq-sdk": "^0.37.0",
    "hnswlib-node": "^3.0.0",
    "json5": "^2.2.3",
    "jsonrepair": "^3.15.0",
    "latest-version": "^9.0.0",
    "mnemonist": "^0.40.4",
    "node-cron": "^4.6.0",
    "open": "^11.0.0",
    "openai": "^6.45.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.17.2",
    "pino": "^9.2.0",
    "playwright": "^1.61.1",
    "prompts": "^2.4.2",
    "proper-lockfile": "^4.1.2",
    "qrcode-terminal": "^0.12.0",
    "redis": "^4.7.0",
    "shell-quote": "^1.9.0",
    "simple-git": "^3.36.0",
    "strip-ansi": "^7.2.0",
    "strip-json-comments": "^5.0.3",
    "tar": "^7.5.19",
    "telegram": "^2.26.22",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.26.10",
    "wikipedia": "^2.1.2",
    "ws": "^8.21.0",
    "yargs": "^18.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cli-progress": "^3.11.6",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/jest": "^30.0.0",
    "@types/node": "~25.9.1",
    "@types/node-cron": "^3.0.11",
    "@types/prompts": "^2.4.9",
    "@types/ws": "^8.18.1",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "jest": "^30.3.0",
    "knip": "^6.33.0",
    "oxlint": "^1.80.0",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.9",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.68.0"
  },
  "overrides": {
    "axios": "^1.7.9",
    "sharp": "^0.35.0",
    "trim": "^1.0.1",
    "form-data": "^4.0.1",
    "file-type": "^21.3.4"
  },
  "allowScripts": {
    "@ffmpeg-installer/linux-x64@4.1.0": true,
    "@google/genai@2.10.0": true,
    "@whiskeysockets/baileys@6.7.23": true,
    "agent-browser@0.31.1": true,
    "bufferutil@4.1.0": true,
    "core-js@2.6.12": true,
    "es5-ext@0.10.64": true,
    "esbuild@0.28.1": true,
    "hnswlib-node@3.0.0": true,
    "protobufjs@7.6.5": true,
    "unrs-resolver@1.12.2": true,
    "utf-8-validate@5.0.10": true
  }
}
